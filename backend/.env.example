# Application
APP_NAME="AI Maintenance & Optimization System"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=development

# API
API_PREFIX=/api
SECRET_KEY=your-secret-key-change-this-in-production-minimum-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_maintenance_db

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# RAG
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=5

# ML
ML_MODEL_PATH=models/
ML_ANOMALY_CONTAMINATION=0.1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
